{
  "description": "pstack guards for rules that a command line can decide.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Glob|Grep",
        "hooks": [
          { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.py\" transcripts" }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "if": "Bash(git *)", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.py\" force-push" }
        ]
      }
    ]
  }
}
