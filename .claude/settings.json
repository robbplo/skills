{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/dev-hooks.py\" paths" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "if": "Bash(gh pr create*)", "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/dev-hooks.py\" version" }
        ]
      }
    ]
  }
}
